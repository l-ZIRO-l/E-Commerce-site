# Neon Postgres connection string (pooled URL works for app + migrations)
DATABASE_URL=

# Auth session signing secret (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Razorpay — get keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Dev only: set to 1 to complete purchases without Razorpay keys (never in production)
DEV_FAKE_PAY=

# Email (M6)
EMAIL_API_KEY=
EMAIL_FROM=
